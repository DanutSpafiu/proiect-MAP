generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Elev {
  id        String   @id @default(uuid())
  name      String
  clasa     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relatie cu notele
  note      Nota[]
}

model Materie {
  id        String   @id @default(uuid())
  nume      String   @unique
  createdAt DateTime @default(now())

  // Relatie cu notele
  note      Nota[]
}

model Nota {
  id         String   @id @default(uuid())
  valoare    Int
  data       DateTime @default(now())

  elevId     String
  materieId  String

  elev       Elev     @relation(fields: [elevId], references: [id])
  materie    Materie  @relation(fields: [materieId], references: [id])
}
